{
  "name": "rps-obe-studio",
  "private": true,
  "version": "0.5.0",
  "packageManager": "pnpm@11.3.0",
  "type": "module",
  "scripts": {
    "test": "tsx --test server/tests/*.test.ts",
    "dev": "concurrently -k -n api,web -c blue,cyan \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "pnpm typecheck:server && tsc -b && vite build",
    "build:portable": "tsc -b && vite build",
    "lint": "oxlint src server drizzle.config.ts vite.config.ts",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx server/scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@better-auth/drizzle-adapter": "^1.7.4",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@hookform/resolvers": "^5.9.1",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.10",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "ai": "^7.0.99",
    "better-auth": "^1.7.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.2",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "eventsource-parser": "^3.1.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.4",
    "idb": "^8.0.3",
    "lucide-react": "^1.38.0",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.19.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite-plugin-singlefile": "^2.3.3",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
